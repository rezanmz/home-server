+@mcp.tool()
+async def start_research(query: str) -> Dict[str, Any]:
+    """
+    Start a background web deep research on a given query and return its ID
+    immediately, without waiting for the research to finish. Prefer this over
+    deep_research for full researches.
+
+    Poll the outcome with research_status(research_id); when it reports
+    "completed" it includes the same context and sources deep_research would
+    have returned, so no further research call is needed. Relays the current
+    phase between polls so the user is not left without updates.
+
+    Args:
+        query: The research query or topic
+
+    Returns:
+        Dict containing the research_id to pass to research_status
+    """
+    logger.info(f"Starting background research on query: {query}...")
+    research_id = _start_research_task(query)
+    return create_success_response({
+        "research_id": research_id,
+        "query": query,
+        "status": "started",
+        "next_step": (
+            "Call research_status with this research_id and wait_seconds=90 "
+            "until status is completed or failed. Share the reported phase "
+            "with the user between polls."
+        ),
+    })
+
+
+@mcp.tool()
+async def research_status(research_id: str, wait_seconds: int = 90) -> Dict[str, Any]:
+    """
+    Report the progress of a background research started with start_research.
+
+    Waits server-side up to wait_seconds (clamped to 0-120) for completion.
+    If the research is still running, returns its current phase, elapsed
+    time, partial progress, and accumulated cost so the caller can tell the
+    user where the research stands, then should call again. When completed,
+    returns the full research payload (context, sources, source_urls) in the
+    same shape deep_research produces; write_report accepts this
+    research_id.
+
+    Args:
+        research_id: The ID returned by start_research
+        wait_seconds: Max seconds this call waits for completion (default 90)
+
+    Returns:
+        Dict with status (running|completed|failed), phase, elapsed_seconds,
+        progress, and on completion the research context and sources
+    """
+    job = research_jobs.get(research_id)
+    if not job:
+        return create_error_response(
+            "Research ID not found. It may predate a server restart; "
+            "start the research again with start_research."
+        )
+    wait = max(0, min(int(wait_seconds), 120))
+    if job["status"] == "running" and wait:
+        try:
+            await asyncio.wait_for(job["done"].wait(), timeout=wait)
+        except asyncio.TimeoutError:
+            pass
+    payload: Dict[str, Any] = {
+        "research_id": research_id,
+        "query": job["query"],
+        "status": job["status"],
+        "phase": job["phase"],
+        "elapsed_seconds": round((job["finished_at"] or time.time()) - job["started_at"], 1),
+    }
+    if job["progress"]:
+        payload["progress"] = job["progress"]
+    if job["cost_usd"] is not None:
+        try:
+            payload["cost_usd"] = round(float(job["cost_usd"]), 4)
+        except (TypeError, ValueError):
+            pass
+    if job["status"] == "running":
+        payload["next_step"] = (
+            "Still running; call research_status again (wait_seconds=90) "
+            "and tell the user the current phase."
+        )
+        return create_success_response(payload)
+    if job["status"] == "failed":
+        return create_error_response(f"Research failed: {job['error']}")
+    payload.update(job["result"])
+    return create_success_response(payload)
+
+
