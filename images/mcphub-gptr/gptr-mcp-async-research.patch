+# Home-server async research jobs.
+#
+# A blocking deep_research call runs for the entire research (often more
+# than five minutes). MCP gateways and clients bound how long a single
+# response stream may stay silent (Open WebUI's MCP client drops it at
+# 300 s), which orphans the finished, paid-for result. start_research
+# launches the same work as a background task and research_status
+# long-polls it in bounded slices, so every MCP call returns promptly and
+# the caller can report the current phase to the user between polls.
+
+# research_id -> mutable job record. Finished jobs keep their payload so
+# polls after completion are cheap and idempotent.
+research_jobs: Dict[str, Dict[str, Any]] = {}
+# Strong references to live background tasks so the event loop keeps them.
+_research_tasks: Dict[str, "asyncio.Task"] = {}
+_MAX_RETAINED_RESEARCH_JOBS = 50
+
+
+class ResearchJobHandler:
+    """GPTResearcher log_handler that records phase events into a job."""
+
+    def __init__(self, job: Dict[str, Any]):
+        self.job = job
+
+    async def on_research_step(self, step: str, details: Any = None, **kwargs):
+        if step == "cost_update":
+            if isinstance(details, dict):
+                self.job["cost_usd"] = details.get("total_cost")
+            return
+        self.job["phase"] = str(step)
+
+    async def on_agent_action(self, action: str, **kwargs):
+        self.job["phase"] = str(action)
+
+    async def on_tool_start(self, tool_name: str, **kwargs):
+        self.job["phase"] = f"tool:{tool_name}"
+
+
+def _prune_research_jobs() -> None:
+    finished = [j for j in research_jobs.values() if j["status"] != "running"]
+    overflow = len(finished) - _MAX_RETAINED_RESEARCH_JOBS
+    if overflow <= 0:
+        return
+    ordered = sorted(finished, key=lambda j: j["finished_at"] or 0)
+    for stale in ordered[:overflow]:
+        research_jobs.pop(stale["research_id"], None)
+
+
+def _start_research_task(query: str) -> str:
+    research_id = str(uuid.uuid4())
+    job: Dict[str, Any] = {
+        "research_id": research_id,
+        "status": "running",
+        "phase": "queued",
+        "query": query,
+        "started_at": time.time(),
+        "finished_at": None,
+        "error": None,
+        "cost_usd": None,
+        "progress": {},
+        "result": None,
+        "done": asyncio.Event(),
+    }
+    research_jobs[research_id] = job
+    _prune_research_jobs()
+
+    async def _run() -> None:
+        researcher = GPTResearcher(query, log_handler=ResearchJobHandler(job))
+
+        def _on_progress(progress: Any) -> None:
+            job["phase"] = "deep_research"
+            job["progress"] = {
+                "depth": getattr(progress, "depth", None),
+                "breadth": getattr(progress, "breadth", None),
+                "total_queries": getattr(progress, "total_queries", None),
+                "completed_queries": getattr(progress, "completed_queries", None),
+                "current_query": getattr(progress, "current_query", None),
+            }
+
+        try:
+            await researcher.conduct_research(on_progress=_on_progress)
+            mcp.researchers[research_id] = researcher
+            logger.info(f"Research completed for ID: {research_id}")
+
+            context = researcher.get_research_context()
+            sources = researcher.get_research_sources()
+            source_urls = researcher.get_source_urls()
+            store_research_results(query, context, sources, source_urls)
+            job["result"] = {
+                "source_count": len(sources),
+                "context": context,
+                "sources": format_sources_for_response(sources),
+                "source_urls": source_urls,
+            }
+            job["status"] = "completed"
+            job["phase"] = "research_completed"
+        except Exception as e:
+            job["status"] = "failed"
+            job["error"] = str(e)
+            logger.error(f"Background research failed for ID {research_id}: {e}")
+        finally:
+            job["finished_at"] = time.time()
+            job["done"].set()
+            _research_tasks.pop(research_id, None)
+
+    _research_tasks[research_id] = asyncio.create_task(_run())
+    return research_id
+
 
