+const MILLISECONDS_PER_DAY = 86_400_000;
+
+type ReconciliationAccount = Account & {
+  last_reconciled?: string | number | null;
+};
+
+/** Normalize Actual's millisecond-string field while tolerating future ISO values. */
+export function normalizeLastReconciled(value: string | number | null | undefined): string | null {
+  if (value === null || value === undefined) return null;
+
+  const text = String(value).trim();
+  if (!text) return null;
+
+  const timestamp = /^\d+$/.test(text) ? Number(text) : Date.parse(text);
+  if (!Number.isFinite(timestamp)) return null;
+
+  const date = new Date(timestamp);
+  return Number.isNaN(date.getTime()) ? null : date.toISOString();
+}
+
+/** Return whole elapsed days so agents can compare reconciliation recency. */
+export function daysSinceReconciliation(
+  value: string | number | null | undefined,
+  now: Date = new Date()
+): number | null {
+  const normalized = normalizeLastReconciled(value);
+  if (!normalized) return null;
+
+  const elapsed = now.getTime() - Date.parse(normalized);
+  return Math.max(0, Math.floor(elapsed / MILLISECONDS_PER_DAY));
+}
 
