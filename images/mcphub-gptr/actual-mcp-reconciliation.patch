+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+vi.mock('../../core/data/fetch-accounts.js', () => ({
+  fetchAllAccounts: vi.fn(),
+}));
+
+vi.mock('@actual-app/api', () => ({
+  aqlQuery: vi.fn(),
+  getAccountBalance: vi.fn(),
+  q: vi.fn(() => ({
+    select: vi.fn(() => ({ table: 'accounts', fields: ['id', 'last_reconciled'] })),
+  })),
+}));
+
+import { aqlQuery, getAccountBalance, q } from '@actual-app/api';
+import { fetchAllAccounts } from '../../core/data/fetch-accounts.js';
+import { daysSinceReconciliation, handler, normalizeLastReconciled } from './index.js';
+
+describe('get-accounts reconciliation metadata', () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+  });
+
+  it('normalizes Actual millisecond timestamps', () => {
+    expect(normalizeLastReconciled('1784688927512')).toBe('2026-07-22T02:55:27.512Z');
+  });
+
+  it('preserves valid ISO timestamps', () => {
+    expect(normalizeLastReconciled('2026-07-01T12:00:00.000Z')).toBe('2026-07-01T12:00:00.000Z');
+  });
+
+  it('returns null for absent or invalid reconciliation timestamps', () => {
+    expect(normalizeLastReconciled(null)).toBeNull();
+    expect(normalizeLastReconciled('not-a-date')).toBeNull();
+  });
+
+  it('computes whole elapsed days and does not return negative ages', () => {
+    const now = new Date('2026-07-22T23:00:00.000Z');
+    expect(daysSinceReconciliation('2026-07-20T12:00:00.000Z', now)).toBe(2);
+    expect(daysSinceReconciliation('2026-07-23T12:00:00.000Z', now)).toBe(0);
+    expect(daysSinceReconciliation(null, now)).toBeNull();
+  });
+
+  it('joins authoritative AQL reconciliation metadata with public account details', async () => {
+    vi.mocked(fetchAllAccounts).mockResolvedValue([
+      {
+        id: 'account-1',
+        name: 'Checking',
+        type: 'checking',
+        offbudget: false,
+        closed: false,
+      },
+      {
+        id: 'account-2',
+        name: 'Cash',
+        type: 'cash',
+        offbudget: false,
+        closed: false,
+      },
+    ] as unknown as Awaited<ReturnType<typeof fetchAllAccounts>>);
+    vi.mocked(aqlQuery).mockResolvedValue({
+      data: [
+        { id: 'account-1', last_reconciled: '1784688927512' },
+        { id: 'account-2', last_reconciled: null },
+      ],
+    });
+    vi.mocked(getAccountBalance).mockResolvedValue(12345);
+
+    const result = await handler();
+    const content = result.content[0];
+    expect(content.type).toBe('text');
+    if (content.type !== 'text') {
+      throw new Error(`Expected text result, received ${content.type}`);
+    }
+
+    const accounts = JSON.parse(content.text);
+    expect(q).toHaveBeenCalledWith('accounts');
+    expect(aqlQuery).toHaveBeenCalledOnce();
+    expect(accounts[0]).toMatchObject({
+      id: 'account-1',
+      name: 'Checking',
+      balance: '$123.45',
+      lastReconciledAt: '2026-07-22T02:55:27.512Z',
+    });
+    expect(accounts[0].daysSinceReconciliation).toEqual(expect.any(Number));
+    expect(accounts[1]).toMatchObject({
+      id: 'account-2',
+      lastReconciledAt: null,
+      daysSinceReconciliation: null,
+    });
+  });
+});
