FROM ghcr.io/nesquena/hermes-webui:0.36.1

# Install git (needed by pip to clone hermes-agent) and build deps
RUN apt-get update && \
    apt-get install -y --no-install-recommends git build-essential && \
    rm -rf /var/lib/apt/lists/*

# Install hermes-agent Python packages so the WebUI can import agent modules
# (openai, anthropic, cron, tools, etc.)
RUN pip install --no-cache-dir --break-system-packages \
    "hermes-agent[all] @ git+https://github.com/NousResearch/hermes-agent.git@v2026.4.3"
