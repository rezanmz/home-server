diff --git a/docker/images/stork.Dockerfile b/docker/images/stork.Dockerfile
index a187185..4c9e884 100644
--- a/docker/images/stork.Dockerfile
+++ b/docker/images/stork.Dockerfile
@@ -179,6 +179,24 @@ COPY --from=agent-builder /app/dist/agent /
 ENTRYPOINT [ "/usr/bin/stork-agent" ]
 # Incoming port
 EXPOSE 8080
+
+# Home-server runtime target: the sidecar must execute the monitored Kea
+# binary to identify its version. Import the exact Kea runtime without
+# replacing the upstream Debian agent base, then drop to a named user.
+FROM docker.cloudsmith.io/isc/docker/kea-dhcp4:3.2.0@sha256:9c67ace6719e846cab3dcbac594530f6b45f3c6aa74be1ca41702bca2cfa3176 AS kea-runtime
+FROM agent AS agent-nonroot
+COPY --from=kea-runtime /usr/sbin/kea-dhcp4 /usr/sbin/kea-dhcp4
+COPY --from=kea-runtime /lib/ld-musl-x86_64.so.1 /lib/ld-musl-x86_64.so.1
+COPY --from=kea-runtime /usr/lib/ /opt/kea-runtime/usr/lib/
+RUN printf '/opt/kea-runtime/usr/lib\n' > /etc/ld-musl-x86_64.path \
+        && printf 'stork-agent:x:1000:1000:Stork Agent:/var/lib/stork-agent:/usr/sbin/nologin\n' >> /etc/passwd \
+        && printf 'stork-agent:x:1000:\n' >> /etc/group \
+        && mkdir -p /var/lib/stork-agent \
+        && ln -s ld-musl-x86_64.so.1 /lib/libc.musl-x86_64.so.1 \
+        && chown 0:0 /usr/sbin/kea-dhcp4 \
+        && chmod 0755 /usr/sbin/kea-dhcp4 \
+        && chown 1000:1000 /var/lib/stork-agent
+USER 1000:1000
 # Prometheus Kea port
 EXPOSE 9547
 # Prometheus Bing9 port
